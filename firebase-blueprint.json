{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User accounts and permissions for app users",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "memberId": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "members": {
      "title": "Club Members",
      "description": "Expat club member directory",
      "properties": {
        "fullName": { "type": "string" },
        "fullNameBn": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "joinDate": { "type": "string" },
        "status": { "type": "string" },
        "photoUrl": { "type": "string" },
        "totalDeposit": { "type": "number" },
        "qrCodeData": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["fullName", "email", "status"]
    },
    "deposits": {
      "title": "Deposits",
      "description": "Member financial deposits and allocations",
      "properties": {
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "amount": { "type": "number" },
        "shareCount": { "type": "number" },
        "shareUnitPrice": { "type": "number" },
        "currency": { "type": "string" },
        "depositDate": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "targetMonth": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["memberId", "amount", "currency", "depositDate"]
    },
    "projects": {
      "title": "Real Estate Projects",
      "description": "Real estate investment assets",
      "properties": {
        "projectName": { "type": "string" },
        "projectNameBn": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "propertyType": { "type": "string" },
        "investmentAmount": { "type": "number" },
        "currentValue": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["projectName", "investmentAmount", "status"]
    },
    "reports": {
      "title": "Financial Reports",
      "description": "Generated club financial & portfolio reports",
      "properties": {
        "title": { "type": "string" },
        "period": { "type": "string" },
        "generatedAt": { "type": "string" },
        "reportType": { "type": "string" }
      },
      "required": ["title", "period"]
    },
    "activity_logs": {
      "title": "Activity Logs",
      "description": "System action history for audit",
      "properties": {
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "details"]
    },
    "system_settings": {
      "title": "System Settings",
      "description": "Global application configuration",
      "properties": {
        "clubName": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "minDepositAmount": { "type": "number" },
        "shareUnitPrice": { "type": "number" },
        "allowNewRegistrations": { "type": "boolean" },
        "allowMemberSelfEdit": { "type": "boolean" },
        "allowMemberPhotoUpload": { "type": "boolean" }
      },
      "required": ["clubName"]
    },
    "quotes": {
      "title": "Daily Quotes & Motivation",
      "description": "Inspirational and investment quotes shown on home dashboard",
      "properties": {
        "quote": { "type": "string" },
        "author": { "type": "string" },
        "authorDesignation": { "type": "string" },
        "category": { "type": "string" },
        "isActive": { "type": "boolean" },
        "displayOrder": { "type": "number" }
      },
      "required": ["quote", "author"]
    },
    "board_directors": {
      "title": "Board of Directors",
      "description": "Official club board of directors and committee members",
      "properties": {
        "name": { "type": "string" },
        "nameBn": { "type": "string" },
        "designation": { "type": "string" },
        "designationBn": { "type": "string" },
        "bio": { "type": "string" },
        "photoUrl": { "type": "string" },
        "email": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "designation"]
    },
    "trashed_items": {
      "title": "Recycle Bin",
      "description": "Deleted items retained for audit and recovery",
      "properties": {
        "originalCollection": { "type": "string" },
        "originalId": { "type": "string" },
        "itemData": { "type": "object" },
        "deletedAt": { "type": "string" }
      },
      "required": ["originalCollection", "originalId", "deletedAt"]
    },
    "active_sessions": {
      "title": "Active Sessions",
      "description": "Active logged in sessions for real-time monitoring",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "lastSeen": { "type": "string" }
      },
      "required": ["userId", "userEmail"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User accounts and permissions"
    },
    "/members/{memberId}": {
      "schema": "members",
      "description": "Club member profiles and status"
    },
    "/deposits/{depositId}": {
      "schema": "deposits",
      "description": "Member deposits and transaction receipts"
    },
    "/projects/{projectId}": {
      "schema": "projects",
      "description": "Club investment projects"
    },
    "/reports/{reportId}": {
      "schema": "reports",
      "description": "Club financial reports"
    },
    "/activity_logs/{logId}": {
      "schema": "activity_logs",
      "description": "Audit trail of user and system activities"
    },
    "/system_settings/{settingId}": {
      "schema": "system_settings",
      "description": "System configuration and settings"
    },
    "/quotes/{quoteId}": {
      "schema": "quotes",
      "description": "Inspirational quotes"
    },
    "/board_directors/{directorId}": {
      "schema": "board_directors",
      "description": "Board of directors information"
    },
    "/trashed_items/{trashId}": {
      "schema": "trashed_items",
      "description": "Recycle bin items"
    },
    "/active_sessions/{sessionId}": {
      "schema": "active_sessions",
      "description": "Active user sessions"
    }
  }
}
